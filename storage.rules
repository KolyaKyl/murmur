rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Аватарки. Каждый видит и меняет только свою.
    // Ограничение по типу и размеру — чтобы в бакет не залили что попало.
    match /users/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Каталог: аудио и обложки. Читают все авторизованные,
    // пишем только мы — через консоль или CLI, они правила обходят.
    match /sounds/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /covers/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
